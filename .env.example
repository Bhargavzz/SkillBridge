# ── Groq Cloud LLM ────────────────────────────────────────────────────────────
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ── PostgreSQL credentials ─────────────────────────────────────────────────────
# Used by docker-compose (db service) AND by the backend app at runtime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=skillbridge

# Local dev URLs — point to localhost (Docker overrides these to use 'db' container)
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5433/skillbridge"
CHECKPOINT_DATABASE_URL="postgresql://postgres:your_password_here@localhost:5433/skillbridge"

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
